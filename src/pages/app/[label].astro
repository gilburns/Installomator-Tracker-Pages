---
import Base from '../../layouts/Base.astro';
import { SOURCES, allTitles, formatDate, iconSrc, isSkipped, isUrl, labelSourceUrl, metadataIconUrl, metadataPlistUrl } from '../../lib/apps.js';
import CopyButton from '../../components/CopyButton.astro';
import PrBadge from '../../components/PrBadge.astro';

export function getStaticPaths() {
  return allTitles.map((app) => ({ params: { label: app.label }, props: { app } }));
}

const { app } = Astro.props;
// Undefined for failing labels the tracker has never resolved.
const latest = app.versions[0];
const failing = app.failing;
const skipped = isSkipped(app);
const linkLabels = { homepage: 'Website', documentation: 'Documentation', privacy: 'Privacy policy' };
const hasIntel = app.versions.some((v) => v.downloadURLi386);
// Signed links are checked against the build time; the site rebuilds twice a day.
const builtAt = new Date().toISOString();
const isSigned = (v) => v.signedUntil !== undefined;
const expiryTime = (iso) => `${formatDate(iso)} at ${iso.slice(11, 16)} UTC`;
const signedLabel = (v) => (!v.signedUntil ? 'Expiring link' : v.signedUntil < builtAt ? 'Expired link' : 'Expires soon');
const signedTitle = (v) =>
  `The vendor issues short-lived signed download links. ${
    !v.signedUntil
      ? 'This one has most likely expired.'
      : v.signedUntil < builtAt
        ? `This one expired ${expiryTime(v.signedUntil)} and no longer works.`
        : `This one stops working ${expiryTime(v.signedUntil)}.`
  }`;
const publisherCount = app.publisher ? allTitles.filter((a) => a.publisher === app.publisher).length : 0;
---
<Base title={app.name} description={app.description || (latest ? `Version history for ${app.name}.` : `Tracker status for ${app.name}.`)}>
  <p class="crumbs"><a href="/browse/">Browse</a> / <a href={`/browse/?category=${encodeURIComponent(app.category)}`}>{app.category}</a></p>

  <section class="card head">
    <img class="icon" src={iconSrc(app, 256)} alt="" width="112" height="112" />
    <div class="head-text">
      <h1>{app.name}</h1>
      {app.publisher && (
        <p class="publisher">
          <span class="muted">{app.publisher}</span>{' '}
          <a class="chip" href={`/browse/?publisher=${encodeURIComponent(app.publisher)}`} title={`Browse all titles by ${app.publisher}`}>
            {publisherCount === 1 ? '1 title' : `All ${publisherCount} titles`} →
          </a>
        </p>
      )}
      {latest ? (
        <p class="latest">
          {failing ? 'Last captured' : 'Latest'} <strong class="version">{latest.version}</strong>{' '}
          <span class="muted">· seen {formatDate(latest.timeStamp)}</span>
          {failing && (skipped ? <> <span class="chip">Skipped</span></> : <> <span class="chip warn">Not updating</span></>)}
        </p>
      ) : (
        <p class="latest">{skipped ? <span class="chip">Skipped</span> : <span class="chip warn">Failing</span>} <span class="muted">No version captured yet</span></p>
      )}
      <p class="pr-line"><PrBadge label={app.label} link detail /></p>
      {app.description && <p class="desc">{app.description} <CopyButton value={app.description} what="description" /></p>}
      {Object.keys(app.links).length > 0 && (
        <p class="links">
          {Object.entries(app.links).map(([k, url]) => <a href={url} rel="noopener">{linkLabels[k] ?? k}</a>)}
        </p>
      )}
    </div>
  </section>

  <section class="facts card">
    <dl>
      <div><dt>Installomator label</dt><dd><code>{app.label}</code><CopyButton value={app.label} what="label" /></dd></div>
      <div><dt>Category</dt><dd><a href={`/browse/?category=${encodeURIComponent(app.category)}`}>{app.category}</a></dd></div>
      {app.bundleId && <div><dt>Bundle ID</dt><dd><code>{app.bundleId}</code><CopyButton value={app.bundleId} what="bundle ID" /></dd></div>}
      {latest?.teamID && <div><dt>Team ID</dt><dd><code>{latest.teamID}</code><CopyButton value={latest.teamID} what="team ID" /></dd></div>}
      {latest?.type && <div><dt>Package type</dt><dd>{latest.type}</dd></div>}
      {app.blockingProcesses?.length > 0 && <div><dt>Blocking processes</dt><dd>{app.blockingProcesses.join(', ')}</dd></div>}
    </dl>
    {app.keywords.length > 0 && (
      <p class="keywords">
        {app.keywords.map((k) => <a class="chip" href={`/browse/?q=${encodeURIComponent(k)}`}>{k}</a>)}
      </p>
    )}
    <p class="files">
      {app.hasMetadata && (
        <a class="file-btn" href={metadataPlistUrl(app.label)} data-save-as={`${app.label}.plist`}>
          <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d="M10 3v9m0 0-3.5-3.5M10 12l3.5-3.5M4 15.5h12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Metadata plist
        </a>
      )}
      {app.hasIcon && (
        <a class="file-btn" href={metadataIconUrl(app.label)} data-save-as={`${app.label}.png`}>
          <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d="M10 3v9m0 0-3.5-3.5M10 12l3.5-3.5M4 15.5h12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Original icon (PNG)
        </a>
      )}
      <a class="file-btn" href={labelSourceUrl(app.label)} rel="noopener" title="View this label's script in the Installomator repo on GitHub">
        <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d="M11 4h5v5m0-5-7 7M8.5 5H5.5A1.5 1.5 0 0 0 4 6.5v8A1.5 1.5 0 0 0 5.5 16h8a1.5 1.5 0 0 0 1.5-1.5v-3" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Label script
      </a>
      <span class="muted small">
        {(app.hasMetadata || app.hasIcon) && <>From <a href={SOURCES.metadata}>Installomator-Metadata</a> and <a href={SOURCES.installomator}>Installomator</a></>}
        {!app.hasMetadata && !app.hasIcon && <>From <a href={SOURCES.installomator}>Installomator</a></>}
      </span>
    </p>
  </section>

  {failing && skipped && (
    <section class="card failure skipped" aria-labelledby="failure-title">
      <h2 id="failure-title">
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><circle cx="10" cy="10" r="7.5" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="M10 9v4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><circle cx="10" cy="6.2" r="1" fill="currentColor"/></svg>
        The tracker skips this label
      </h2>
      <p>
        This label doesn't set <code>appNewVersion</code>, so the tracker has no version to compare and skips it.
        {latest ? ' The history below stops at the last version captured before that.' : ' Its history will start here if the label is changed to set one.'}
      </p>
      <dl>
        <div><dt>Reason</dt><dd><code>{failing.reason}</code></dd></div>
        {failing.since && <div><dt>Skipped as of</dt><dd title={failing.since}>{formatDate(failing.since)}</dd></div>}
        {latest && <div><dt>Last new version captured</dt><dd><span class="version">{latest.version}</span> on {formatDate(latest.timeStamp)}</dd></div>}
      </dl>
      <p class="muted small">
        Adding <code>appNewVersion</code> to the label in <a href={SOURCES.installomator}>Installomator</a> lets the tracker record its versions.
      </p>
    </section>
  )}

  {failing && !skipped && (
    <section class="card failure" aria-labelledby="failure-title">
      <h2 id="failure-title">
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M10 2.5 18.5 17h-17z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M10 8v4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><circle cx="10" cy="14.4" r="1" fill="currentColor"/></svg>
        {latest ? 'New versions aren\'t being recorded' : 'The tracker can\'t resolve this label'}
      </h2>
      <p>
        {latest
          ? 'The tracker currently can\'t resolve this label, so new versions aren\'t being captured. The history below may be out of date, and the newest download link may no longer work.'
          : 'The tracker has never resolved this label, so no versions have been recorded yet. Its history will start here once the label resolves.'}
      </p>
      <dl>
        <div><dt>Reason</dt><dd><code>{failing.reason}</code></dd></div>
        {failing.since && <div><dt>Failing as of</dt><dd title={failing.since}>{formatDate(failing.since)}</dd></div>}
        {latest && <div><dt>Last new version captured</dt><dd><span class="version">{latest.version}</span> on {formatDate(latest.timeStamp)}</dd></div>}
      </dl>
      <p class="muted small">
        Failing labels are retried when Installomator's label files change, and at least every 7 days.
        The <a href={`${SOURCES.tracker}#faq`}>Installomator-Tracker FAQ</a> explains common failures.
        Fixes to the label itself are welcome in <a href={SOURCES.installomator}>Installomator</a>.
      </p>
    </section>
  )}

  {latest && <section>
    <h2>Version history</h2>
    <p class="muted note">
      {app.versions.length} {app.versions.length === 1 ? 'version' : 'versions'} recorded.
      "Seen" is when the tracker first found the version, not the vendor's release date.
      A version without a download link belongs to a label whose link always serves the latest release.
    </p>
    {app.staticUrl && (
      <div class="card callout">
        <strong>This label's download link always serves the latest version.</strong>{' '}
        {app.versions.length === 1
          ? 'The tracker used to replace the previous version each time a new one appeared, so this is the only version recorded so far. New versions will be added here as they appear, and only the newest one will have a download link.'
          : <>
              Only the newest entry has a download link. Older entries show when each version was seen,
              but the link now serves the latest version instead.
              {app.historyReplaced && ` Versions found before ${formatDate(app.versions.at(-1).timeStamp)} weren't recorded.`}
            </>}
      </div>
    )}
    {isSigned(latest) && (
      <div class="card callout warn">
        <strong>This label's download links expire.</strong>{' '}
        The vendor's server hands out a signed link that only works for a short time, often a few hours,
        so the links recorded here have most likely expired. Run the label with Installomator to get a current one.
      </div>
    )}
    <div class="card table-wrap">
      <table>
        <thead>
          <tr>
            <th>Version</th>
            <th>Seen</th>
            <th>Download</th>
          </tr>
        </thead>
        <tbody>
          {app.versions.map((v) => (
            <tr>
              <td class="version">
                {v.version}
                {v.firstSeen && app.versions.length > 1 && <span class="chip new">First seen</span>}
              </td>
              <td class="nowrap" title={v.timeStamp}>{formatDate(v.timeStamp)}</td>
              <td><div class="downloads">
                {isUrl(v.downloadURL) && (
                  <a href={v.downloadURL} rel="nofollow noopener">{hasIntel ? 'Apple silicon' : 'Download'}{v.type && ` (${v.type})`}</a>
                )}
                {isUrl(v.downloadURLi386) && (
                  <a href={v.downloadURLi386} rel="nofollow noopener">Intel{v.type && ` (${v.type})`}</a>
                )}
                {isSigned(v) && (isUrl(v.downloadURL) || isUrl(v.downloadURLi386)) && (
                  <span class="chip warn" title={signedTitle(v)}>{signedLabel(v)}</span>
                )}
                {!isUrl(v.downloadURL) && !isUrl(v.downloadURLi386) && (
                  <span class="muted" title="The download link now serves a newer version">No longer available</span>
                )}
              </div></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>}
</Base>

<script>
  // Save the Installomator-Metadata files instead of opening them: raw.githubusercontent.com
  // allows cross-origin fetches, and a blob URL lets the download attribute name the file.
  // If the fetch fails, the link falls back to opening the raw file.
  for (const link of document.querySelectorAll<HTMLAnchorElement>('a[data-save-as]')) {
    link.addEventListener('click', async (e) => {
      e.preventDefault();
      try {
        const res = await fetch(link.href);
        if (!res.ok) throw new Error(String(res.status));
        const url = URL.createObjectURL(await res.blob());
        const a = Object.assign(document.createElement('a'), { href: url, download: link.dataset.saveAs });
        document.body.append(a);
        a.click();
        a.remove();
        setTimeout(() => URL.revokeObjectURL(url), 10000);
      } catch {
        window.location.href = link.href;
      }
    });
  }
</script>

<style>
  .crumbs { margin: 0 0 12px; font-size: 13px; color: var(--muted); }
  .head { display: flex; gap: 20px; padding: 20px; align-items: flex-start; }
  .head-text { min-width: 0; }
  .head h1 { font-size: 26px; margin-bottom: 2px; }
  .publisher { margin: 0 0 8px; }
  .publisher .chip { margin-left: 4px; vertical-align: 1px; }
  .publisher .chip:hover { text-decoration: none; background: var(--accent); color: var(--surface); }
  .latest { margin: 0 0 10px; }
  .pr-line { margin: 0 0 10px; }
  .pr-line:empty { display: none; }
  .desc { margin: 0 0 10px; max-width: 70ch; }
  .links { display: flex; flex-wrap: wrap; gap: 6px 16px; margin: 0; }
  @media (max-width: 560px) {
    .head { flex-direction: column; }
    .head .icon { width: 80px; height: 80px; }
  }

  .facts { margin: 16px 0 28px; padding: 16px 20px; }
  .facts dl { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 12px 24px; margin: 0; }
  .facts dt { font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: .04em; }
  .facts dd { margin: 2px 0 0; overflow-wrap: anywhere; }
  .keywords { display: flex; flex-wrap: wrap; gap: 6px; margin: 14px 0 0; }
  .facts dd code { margin-right: 2px; }
  .files { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 10px; margin: 16px 0 0; padding-top: 14px; border-top: 1px solid var(--border); }
  .file-btn {
    display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; border-radius: 8px;
    border: 1px solid var(--border); background: var(--bg); color: var(--text); font-size: 14px;
  }
  .file-btn:hover { text-decoration: none; border-color: var(--accent); color: var(--accent); }
  .small { font-size: 13px; }

  h2 { font-size: 20px; }
  .failure { margin: 0 0 28px; padding: 16px 20px; border-left: 3px solid var(--warn); }
  .failure h2 { display: flex; align-items: center; gap: 8px; color: var(--warn); font-size: 17px; }
  .failure h2 svg { flex: none; }
  .failure.skipped { border-left-color: var(--border); }
  .failure.skipped h2 { color: var(--text); }
  .failure p { margin: 0 0 12px; max-width: 80ch; }
  .failure p:last-child { margin: 0; }
  .failure dl { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 12px 24px; margin: 0 0 12px; }
  .failure dt { font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: .04em; }
  .failure dd { margin: 2px 0 0; overflow-wrap: anywhere; }
  .note { margin: 0 0 10px; font-size: 13px; max-width: 80ch; }
  .callout { margin: 0 0 12px; padding: 12px 16px; font-size: 14px; border-left: 3px solid var(--accent); }
  .callout.warn { border-left-color: var(--warn); }
  .table-wrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; }
  th, td { text-align: left; padding: 10px 14px; border-bottom: 1px solid var(--border); vertical-align: top; }
  tbody tr:last-child td { border-bottom: 0; }
  th { font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: .04em; font-weight: 600; }
  td.version { font-weight: 500; max-width: 360px; }
  td.version .chip { margin-left: 6px; }
  .nowrap { white-space: nowrap; }
  .downloads { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 14px; }
</style>
